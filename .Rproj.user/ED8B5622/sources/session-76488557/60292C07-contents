    test.use = "wilcox",       # Standard single-cell differential expression test
    min.pct = 0.10,            # Gene must be in >= 10% of cells in group 1 OR group 2
    logfc.threshold = 0.0      # Evaluates all genes passing the pct threshold for ranking
  )
  
  # Convert row names to a clear 'Gene' column
  diff1$Gene <- rownames(diff1)
  # # save for functional analysis and write out to file
  bubble_all[[diff_name]] <- diff1
  
  # Filter out non-significant genes first
  diff1_sig <- diff1 %>% 
    filter(p_val_adj < 0.05)
  
  # 3. Extract the Top 50 HIGHEST fold change genes (highly expressed in ident.1)
  top_highest <- diff1_sig %>%
    arrange(desc(avg_log2FC)) %>%
    head(num_bubble)
  
  # 4. Extract the Top 50 LOWEST fold change genes (highly expressed in ident.2 / negative FC)
  top_lowest <- diff1_sig %>%
    arrange(avg_log2FC) %>%
    head(num_bubble)
  
  top_symbols <- rbind(top_highest, top_lowest) %>%
    filter(!grepl("^ENS", Gene))
  top_symbols <- top_symbols[!duplicated(top_symbols$Gene),]
  
  colnames(top_symbols)[colnames(top_symbols)=="pct.1"] <- paste(real_ident1, "pct", sep=" ")
  colnames(top_symbols)[colnames(top_symbols)=="pct.2"] <- paste(real_ident2, "pct", sep=" ")
  
  # Save to excel sheet list
  bubble_top[[diff_name]] <- top_symbols
  
  marker_genes <- unique(top_symbols$Gene)
  
  # 5. Extract calculated metrics without plotting yet
  dot_data <- DotPlot(seu_bubble, features = marker_genes, scale = FALSE)$data
  
  # 6. Parse the combined ID string back out into clean, separate plotting columns
  plot_df <- dot_data %>%
    tibble::rownames_to_column(var = "row_id") %>%
    mutate(id = as.character(id))
  
  # Match codes explicitly via direct lookup table
  lookup_df <- data.frame(
    id = unique(seu_bubble$plot_id),
    True_Cluster = seu_bubble$cluster_type_renamed_D42_both[match(unique(seu_bubble$plot_id), seu_bubble$plot_id)],
    True_Sample  = seu_bubble$sample_names_renamed[match(unique(seu_bubble$plot_id), seu_bubble$plot_id)]
  )
  
  # Merge true mapping back safely
  plot_df <- plot_df %>%
    left_join(lookup_df, by = "id") %>%
    mutate(
      Cluster = as.character(True_Cluster),
      Sample  = as.character(True_Sample)
    ) %>%
    filter(pct.exp > 0) 
  
  # Strictly lock factor levels using unique target definitions
  plot_df$features.plot <- factor(plot_df$features.plot, levels = marker_genes)
  plot_df$Cluster       <- factor(plot_df$Cluster, levels = unique(target_clusters))
  plot_df$Sample        <- factor(plot_df$Sample, levels = unique(target_samples))
  
  min_expression <- 0.0
  max_expression <- 4.0
  cikk_breaks <- c(25, 50, 75, 100)
  
  # 7. Create the custom bubble plot
  bubble_plot <- ggplot(plot_df, aes(x = features.plot, y = Sample)) +
    geom_point(aes(size = pct.exp, color = avg.exp.scaled, alpha = pct.exp)) +
    
    facet_grid(Cluster ~ ., scales = "free_y") + 
    
    scale_color_viridis_c(option = "viridis", 
                          name = "Mean expression",
                          guide = guide_legend(order = 1)) + 
    
    scale_size_continuous(
      range = c(1, 7), 
      name = "Expressed in cells",
      breaks = cikk_breaks,
      limits = c(0, 100),
      labels = function(x) paste0(x, "%"),
      guide = guide_legend(order = 2) 
    ) +
    
    scale_alpha_continuous(
      range = c(0.25, 1.0), 
      name = "Expressed in cells", 
      breaks = cikk_breaks,         
      limits = c(0, 100),
      labels = function(x) paste0(x, "%"), 
      guide = guide_legend(order = 2) 
    ) +
    
    labs(x = NULL, y = NULL) +
    theme_bw() +
    theme(
      panel.grid.major = element_line(color = "gray95", size = 0.5),
      panel.grid.minor = element_blank(),
      strip.background = element_rect(fill = "white", color = "black"),
      strip.text.y = element_text(angle = 0, face = "bold", size = 11), 
      axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1, size = 10), 
      axis.text.y = element_text(size = 10),
      legend.position = "right",
      legend.box = "vertical",
      aspect.ratio = 0.08 ,
      plot.margin = margin(t = 10, r = 0, b = 10, l = 0, unit = "pt")
    )+
    scale_x_discrete(expand = expansion(mult = c(0.02, 0.02)))
  
  print(bubble_plot)
  ggsave(file.path(Figures, paste("bubble_plot_diff_", diff_name, "_", ct, "_res_", selres,
                                    "_day_", day, "_nHVG", nHVG_str, ".pdf", sep="")),
               #bubble_plot, width = nrow(top_symbols)*0.2, height = 4, limitsize = FALSE)
               bubble_plot, width = 22, height = 4, limitsize = FALSE)
}

